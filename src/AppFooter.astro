---
import { Image } from 'astro:assets'
import enso from './assets/enso.png'
import { links, SITE } from '@lib/consts'

const externalLinks = [
	{ title: 'LinkedIn', url: 'https://www.linkedin.com/in/gianatiempo/' },
	{ title: 'GitHub', url: 'https://github.com/gianatiempo' },
	{ title: 'RSS', url: '/rss.xml' }
]

/* The nav is four items now, which is one column rather than two. It used to
   be six split into threes to stop the footer going lopsided beside the three
   external links; at four, splitting it would make two stubs. */
---

<footer class="shell border-t border-rule pb-8 pt-16">
	<div class="flex flex-col gap-10 md:flex-row md:justify-between">
		<div>
			<p class="label mb-3 text-primary">Ariel Gianatiempo</p>
			<p class="max-w-[34ch] text-secondary">Málaga, Spain. Eight years of web development with Java, eleven on the Front-End, and currently finding my way back to the server.</p>
		</div>

		<div class="flex flex-wrap gap-x-12 gap-y-8">
			<nav aria-label="Footer">
				<ul class="flex flex-col gap-2.5">
					{
						links.map((link) => (
							<li>
								<a href={link.to} class="label link-sweep hover:text-accent" target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
									{link.label}
									{link.external && <span aria-hidden="true"> ↗</span>}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<ul class="flex flex-col gap-2.5">
				{
					externalLinks.map((link) => (
						<li>
							<a href={link.url} target="_blank" rel="noopener noreferrer" class="label link-sweep hover:text-accent">
								{link.title}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-rule pt-8">
		<p class="label text-quaternary">© {new Date().getFullYear()} {SITE.TITLE} · built with Astro</p>
		<a href="/about#enso" class="group inline-flex items-center gap-2.5" aria-label="Ensō: the story behind the mark">
			<Image src={enso} alt="" width={80} height={80} loading="lazy" class="size-7 shrink-0 opacity-80 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true" />
			<span class="label link-sweep group-hover:text-accent">円相 · the story behind the mark</span>
		</a>
	</div>
</footer>
