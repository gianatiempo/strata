---
/* Dates are measured values, so they are set in the mono voice by every caller
   (`.time`). The format is deliberately short and fixed-width: "Sep 12, 2026"
   is eleven characters whatever the month, so a column of them in the archive
   aligns without a table and without tabular hacks beyond the ones `.time`
   already applies. */
interface Props {
	date: Date
	class?: string
}

const { date, class: className } = Astro.props
---

<time datetime={date.toISOString()} class={className}>
	{
		date.toLocaleDateString('en-US', {
			month: 'short',
			day: '2-digit',
			year: 'numeric',
			timeZone: 'UTC'
		})
	}
</time>
