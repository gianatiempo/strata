---
type Props = {
	href: string
}

const { href } = Astro.props
---

<a href={href} class="group inline-flex w-fit items-center gap-2 rounded border border-rule px-3 py-2 text-secondary transition-colors duration-300 ease-out hover:text-accent">
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2" aria-hidden="true">
		<line x1="5" y1="12" x2="19" y2="12" class="origin-right scale-x-0 transition-transform duration-300 ease-out group-hover:scale-x-100"></line>
		<polyline points="12 5 5 12 12 19" class="translate-x-1 transition-transform duration-300 ease-out group-hover:translate-x-0"></polyline>
	</svg>
	<span class="label"><slot /></span>
</a>
