---
import FormattedDate from '@components/blog/FormattedDate.astro'
import PostNavigation from '@components/blog/PostNavigation.astro'
import BackToPrevious from '@components/blog/BackToPrevious.astro'
import IdentityCard from '@components/IdentityCard.astro'
import RepoCard from '@components/RepoCard.astro'
import WritingList from '@components/WritingList.astro'
import Layout from '../../Layout.astro'
import { cardAlt, type CardOptions } from '@lib/og'
import { humanize, readingTime, similarItems } from '@lib/utils'
import { beats, beatTone, forms } from '@lib/consts'
import { type CollectionEntry, getCollection } from 'astro:content'
import { slug } from 'github-slugger'

/* One template for posts, notes and projects.
 *
 * There were two of these, and they differed by about fifteen lines: a project
 * shows a status and a stack in the rail where a post shows a reading time and
 * its tags. Everything else — the standing rail, prose at measure, the blocks
 * released to the full column, the identity card, the navigation — was
 * duplicated verbatim, which is two places to fix anything and one place to
 * forget.
 */

export async function getStaticPaths() {
	const entries = (await getCollection('writing')).filter((entry) => !entry.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: entry
	}))
}
type Props = CollectionEntry<'writing'>

const entries = (await getCollection('writing')).filter((entry) => !entry.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const index = entries.findIndex((e) => e.slug === Astro.params.slug)
const nextPost = entries[index + 1]
const prevPost = entries[index - 1]

const entry = Astro.props
const { Content, headings } = await entry.render()

const beat = beats[entry.data.beat]
const form = entry.data.form
const similar = similarItems(entry, entries, entry.slug)

/* Top-level sections only. A contents list that mirrors every h3 stops being a
   map and becomes a second copy of the article. */
const toc = headings.filter((heading) => heading.depth === 2)

const externals = [{ label: 'Demo', href: entry.data.demoURL }].filter((link): link is { label: string; href: string } => Boolean(link.href))

/* Its own link preview, generated by src/pages/og/[...slug].png.ts from these
   same fields. A project leads with its status rather than a reading time —
   what a reader wants to know before clicking one is whether it is finished. */
const card: CardOptions = {
	title: entry.data.title,
	kicker: forms[form].label,
	beat: { label: beat.label, tone: beat.tone },
	meta:
		form === 'project'
			? [entry.data.status ?? 'In progress', new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(entry.data.date)]
			: [new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(entry.data.date), readingTime(entry.body)]
}
---

<Layout title={entry.data.title} description={entry.data.description} type="article" publishedDate={entry.data.date} image={`/og/writing/${entry.slug}.png`} imageAlt={cardAlt(card)}>
	<!-- Reading progress. Scroll-linked in CSS, so it costs no JavaScript and
	     disappears entirely when the reader has asked for reduced motion. -->
	<div class="progress-rail" aria-hidden="true"><span data-progress></span></div>

	<main class="overflow-clip pt-32 sm:pt-40">
		<article class="shell shell-river">
			<div class="longform">
				<header class="longform-head">
					<h1 class="text-display leading-[0.95] tracking-[-0.03em]">{entry.data.title}</h1>

					<!-- Layer one, and free: `description` already exists on every
					     entry, is already written in plain language for search results
					     and link previews, and is the sentence a reader arriving cold
					     from LinkedIn needs before any of the article's vocabulary. -->
					{entry.data.description && <p class="claim measure-wide mt-8">{entry.data.description}</p>}
				</header>

				<div class="longform-grid">
					<aside class="longform-rail">
						<dl class="grid gap-2.5">
							<div>
								<dt class="sr-only">Beat</dt>
								<dd>
									<a href={`/beat/${entry.data.beat}`} class:list={['label beat transition-colors duration-300 ease-out hover:text-accent-hover', beatTone[beat.tone]]}>
										{beat.label}
									</a>
								</dd>
							</div>

							{
								form === 'project' && entry.data.status && (
									<div>
										<dt class="sr-only">Status</dt>
										<dd class="label text-primary">{entry.data.status}</dd>
									</div>
								)
							}

							<div>
								<dt class="sr-only">Published</dt>
								<dd><FormattedDate date={entry.data.date} class="time" /></dd>
							</div>

							{
								form !== 'project' && (
									<div>
										<dt class="sr-only">Length</dt>
										<dd class="time">{readingTime(entry.body)}</dd>
									</div>
								)
							}
						</dl>

						{
							toc.length > 1 && (
								<nav class="longform-toc border-t border-rule pt-5" aria-label="Contents">
									<p class="label mb-2 text-quaternary">Contents</p>
									{toc.map((heading) => (
										<a href={`#${heading.slug}`}>{heading.text}</a>
									))}
								</nav>
							)
						}

						{
							form === 'project' && entry.data.stack.length > 0 && (
								<div class="border-t border-rule pt-5">
									<p class="label mb-2.5 text-quaternary">Stack</p>
									<ul class="grid gap-1.5">
										{entry.data.stack.map((item) => (
											<li class="label normal-case tracking-[0.03em] text-tertiary">{item}</li>
										))}
									</ul>
								</div>
							)
						}

						{
							form !== 'project' && entry.data.tags?.length > 0 && (
								<ul class="flex flex-wrap gap-x-4 gap-y-2 border-t border-rule pt-5">
									{entry.data.tags.map((tag: string) => (
										<li>
											<a href={`/tag/${slug(tag)}`} class="label normal-case tracking-[0.03em] text-tertiary transition-colors duration-300 ease-out hover:text-accent">
												{humanize(tag)}
											</a>
										</li>
									))}
								</ul>
							)
						}

						{
							externals.length > 0 && (
								<ul class="grid gap-1.5 border-t border-rule pt-5">
									{externals.map((link) => (
										<li>
											<a href={link.href} target="_blank" rel="noopener noreferrer" class="label link-sweep text-accent hover:text-accent-hover">
												{link.label} ↗
											</a>
										</li>
									))}
								</ul>
							)
						}
					</aside>

					<div>
						<div class="longform-body prose">
							<Content />
						</div>

						<!-- Where the code is, when there is code. Below the article
						     rather than in the rail: a reader who has just been told how
						     something was built is the reader most likely to want to
						     open it. -->
						{entry.data.repoURL && <RepoCard class="mt-12" url={entry.data.repoURL} stack={form === 'project' ? entry.data.stack : undefined} />}

						<footer class="longform-foot">
							<!-- Most people who read this arrived from a shared link and
							     have never seen the home page. The card is the only place
							     the entry answers who wrote it and what he's looking for. -->
							<IdentityCard />

							<div class="mt-14 border-t border-rule pt-8">
								<BackToPrevious href="/writing">All writing</BackToPrevious>
							</div>

							<div class="mt-14">
								<PostNavigation prevPost={prevPost} nextPost={nextPost} />
							</div>
						</footer>
					</div>
				</div>
			</div>
		</article>

		{
			similar.length > 0 && (
				<section class="shell shell-river py-section">
					<header class="mb-14">
						<p class="label mb-4 text-accent">Related</p>
						<h1 class="max-w-title">Keep reading.</h1>
					</header>
					<WritingList list={similar.slice(0, 3)} />
				</section>
			)
		}
	</main>
</Layout>
