---
import Layout from '../Layout.astro'
import Masthead from '@components/Masthead.astro'
import WritingList from '@components/WritingList.astro'
import SectionHead from '@components/SectionHead.astro'
import Contact from '@components/Contact.astro'
import { SITE } from '@lib/consts'
import { getCollection } from 'astro:content'

/* A brief summary of who I am and what I do, and the notes that prove it is
 * still happening. Four blocks. That is the whole page.
 *
 * It was six, and 1,270 words — roughly a six-minute read before you reached a
 * single link. Milestones told the career; Practice then told the same career
 * again as a technical inventory, quoting the same numbers (60%, 90%, eleven
 * years, eight years, 2015, 2026) a second time; Testimonials added three more
 * paragraphs on top. "J.P. Morgan" appeared five times on one page, "60%" four
 * times, "rewrite" six.
 *
 * None of it was deleted. Milestones, the practice inventory and the
 * endorsements are all on /about, which is where somebody goes when this page
 * has already convinced them and they want the record. What is left here is
 * the part that does the convincing, plus the writing, which is the only thing
 * on the site that will be different next month.
 */

const latest = (await getCollection('writing'))
	.filter((entry) => !entry.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, SITE.NUM_ENTRIES_ON_HOMEPAGE)
---

<Layout>
	<main class="overflow-clip">
		<Masthead />

		<section class="shell shell-river py-section-tight" id="writing">
			<SectionHead eyebrow="Writing" tick split>
				<h2 class="measure">What I write while I'm still learning how to write.</h2>
				<p slot="note" class="max-w-[34ch] text-secondary">Posts about whatever seems worth writing down, and projects about the things I put on GitHub.</p>
			</SectionHead>

			<WritingList list={latest} feature />

			<a href="/writing" class="group mt-10 inline-flex items-baseline gap-3 text-primary transition-colors duration-300 hover:text-accent" data-rise>
				<span class="label">All writing</span>
				<span class="transition-transform duration-[420ms] ease-glide group-hover:translate-x-1.5">→</span>
			</a>
		</section>

		<Contact />
	</main>
</Layout>
