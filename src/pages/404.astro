---
import BackToPrevious from '@components/blog/BackToPrevious.astro'
import { SITE } from '@lib/consts'
import Layout from 'Layout.astro'
---

<Layout title="Not found" description={SITE.DESCRIPTION}>
	<main class="shell shell-river overflow-clip pb-section-loose pt-40 sm:pt-48">
		<p class="time tick mb-4">404</p>
		<h1 class="max-w-title">This page doesn't exist.</h1>
		<p class="mt-6 max-w-[52ch] text-body-lg text-secondary">Something probably moved when I rebuilt this. The writing is all still here, and the front page is one click away.</p>
		<div class="mt-10 flex flex-wrap gap-4">
			<BackToPrevious href="/">Home</BackToPrevious>
			<BackToPrevious href="/writing">Writing</BackToPrevious>
		</div>
	</main>
</Layout>
